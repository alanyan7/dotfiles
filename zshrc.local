# ── Custom shell functions ──

# cd + ls in one command
function cl {
  builtin cd "$@" && ls -F
}

# mkdir + cd in one command
function mkcd {
  mkdir -p "$@" && builtin cd "${@:$#}"
}

# ── Tool integrations ──

# fzf
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
elif command -v fzf >/dev/null 2>&1; then
  # fzf installed via package manager (brew, apt, etc.)
  eval "$(fzf --zsh 2>/dev/null)" || true
fi

# Use fd as fzf default if available (faster than find)
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi

# zoxide (smart cd — replaces z plugin)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# ── Aliases for modern CLI tools (only if installed) ──

command -v bat     >/dev/null 2>&1 && alias cat='bat --paging=never'
command -v eza     >/dev/null 2>&1 && alias ls='eza' && alias ll='eza -la --git' && alias lt='eza --tree --level=2'
command -v delta   >/dev/null 2>&1 && export GIT_PAGER='delta'

# ── PATH ──

# Ensure ~/.local/bin is in PATH (for fd/bat symlinks on Debian/Ubuntu)
[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"
